# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Your bot's Application (Client) ID, from the same page
CLIENT_ID=1530901682467242015

# Your Discord server (guild) ID — right-click server icon > Copy Server ID
# (Developer Mode must be on in Discord settings > Advanced)
GUILD_ID=1065909306668613703

# Optional: override the SQLite database path so it survives deployments
# Use a separate persistent location outside the repo
# WEIGHT_DB_PATH=/var/lib/weight-bot/weight.db
